---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const cards = (await getCollection("dataSources")).sort((a, b) => a.id.localeCompare(b.id, "ja"));
const base = import.meta.env.BASE_URL;
const list = (v?: string | string[]) => (Array.isArray(v) ? v.join(", ") : (v ?? ""));
---

<Base title="データソース">
  <h1>データソース</h1>
  <p>{cards.length} 件のデータについて、出所、ライセンス、取り出し方、内容をまとめています。</p>
  <table>
    <thead>
      <tr>
        <th>名前</th>
        <th>提供元</th>
        <th>ライセンス</th>
        <th>取り出し方</th>
        <th>確認日</th>
      </tr>
    </thead>
    <tbody>
      {
        cards.map((card) => (
          <tr>
            <td>
              <a href={`${base}data_source/${card.id}/`}>{card.id.split("/").pop()}</a>
            </td>
            <td>{list(card.data.provider)}</td>
            <td>{card.data.license.join(", ")}</td>
            <td class="nowrap">{card.data.access}</td>
            <td class="nowrap">{card.data.checked?.toISOString().slice(0, 10) ?? ""}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<style>
  .nowrap {
    white-space: nowrap;
  }
</style>
