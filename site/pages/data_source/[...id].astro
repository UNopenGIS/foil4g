---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const cards = await getCollection("dataSources");
  return cards.map((card) => ({ params: { id: card.id }, props: { card } }));
}

const { card } = Astro.props;
const { Content } = await render(card);
const d = card.data;
const list = (v?: string | string[]) => (Array.isArray(v) ? v.join(", ") : v);
const rows: [string, string | undefined][] = [
  ["データID", d.id],
  ["提供元", list(d.provider)],
  ["元データ", list(d.source_data)],
  ["ライセンス", d.license.join(", ")],
  ["ライセンスの補足", d.license_note],
  ["取り出し方", d.access],
  ["取り出し方の補足", d.access_note],
  ["データ形式", list(d.format)],
  ["範囲", d.coverage],
  ["期間", d.period],
  ["解像度または単位", d.resolution],
  ["大きさ", d.size],
  ["更新頻度", d.update],
  ["URL", d.url],
  ["説明ページ", d.docs],
  ["確認日", d.checked?.toISOString().slice(0, 10) ?? "確かめていません"],
  ...Object.entries(d.details ?? {}),
];
const isUrl = (v: string) => /^https?:\/\/\S+$/.test(v);
---

<Base title={card.id.split("/").pop() ?? card.id}>
  <h1>{card.id.split("/").pop()}</h1>
  <table class="card-info">
    <tbody>
      {
        rows
          .filter(([, v]) => v)
          .map(([k, v]) => (
            <tr>
              <th>{k}</th>
              <td>{isUrl(v!) ? <a href={v}>{v}</a> : v}</td>
            </tr>
          ))
      }
    </tbody>
  </table>
  <div class="card-body">
    <Content />
  </div>
</Base>

<style>
  /* The page renders the title above the frontmatter table, so hide the
     card's own first heading. */
  .card-body > :global(h1:first-child) {
    display: none;
  }
  .card-info th {
    width: 9em;
  }
</style>
