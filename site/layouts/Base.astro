---
interface Props {
  title: string;
}
const { title } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | FOIL4G</title>
  </head>
  <body>
    <header>
      <a href={home}>FOIL4G</a>
      <a class="logo" href="https://github.com/UNopenGIS/7/issues">
        <img src={`${home}images/un-open-gis-smart-maps.jpg`} alt="UN Open GIS Initiative / Smart Maps" height="40" />
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0 auto;
    max-width: 960px;
    padding: 0 16px 48px;
    font-family: system-ui, sans-serif;
    line-height: 1.7;
    color: #1f2328;
    background: #fff;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid #d0d7de;
    margin-bottom: 24px;
  }
  header .logo img {
    display: block;
    height: 40px;
    width: auto;
  }
  header a {
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  th,
  td {
    border: 1px solid #d0d7de;
    padding: 4px 8px;
    vertical-align: top;
    text-align: left;
    overflow-wrap: anywhere;
  }
  pre {
    overflow-x: auto;
    padding: 12px;
    background: #f6f8fa;
  }
  code {
    font-size: 0.9em;
  }
</style>
